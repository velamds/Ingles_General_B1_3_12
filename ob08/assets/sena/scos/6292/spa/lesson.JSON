 "contents": [{"content": "engenn8le12ob08re4aud03", "type": "audio"}, {"content": "It has been often written by health experts that people", "type": "text"}]}, {"type": "post_question", "contents": {"content": "after themselves if they wish to live long, healthy lives.", "type": ""}}, {"content": "secondary_2", "type": "objective"}], "responses": [{"correct": 0, "selected": 0, "_data": [{"content": "", "type": "text"}], "id": 0}, {"correct": 1, "selected": 0, "_data": [{"content": "have to look", "type": "text"}], "id": 1}], "id": 2}, {"_data": [{"type": "question", "contents": [{"content": "engenn8le12ob08re4aud04", "type": "audio"}, {"content": "There are a number of things people", "type": "text"}]}, {"type": "post_question", "contents": {"content": "to increase their longevity. ", "type": ""}}, {"content": "secondary_2", "type": "objective"}], "responses": [{"correct": 0, "selected": 0, "_data": [{"content": "", "type": "text"}], "id": 0}, {"correct": 1, "selected": 0, "_data": [{"content": "could do", "type": "text"}], "id": 1}], "id": 3}, {"_data": [{"type": "question", "contents": [{"content": "engenn8le12ob08re4aud05", "type": "audio"}, {"content": "It", "type": "text"}]}, {"type": "post_question", "contents": {"content": "to be pulled in a hundred different directions.", "type": ""}}, {"content": "secondary_2", "type": "objective"}], "responses": [{"correct": 0, "selected": 0, "_data": [{"content": "", "type": "text"}], "id": 0}, {"correct": 1, "selected": 0, "_data": [{"content": "must be hard", "type": "text"}], "id": 1}], "id": 4}, {"_data": [{"type": "question", "contents": [{"content": "", "type": "rec"}]}, {"content": "secondary_2", "type": "objective"}], "responses": [{"correct": 0, "selected": 0, "_data": [{"content": "", "type": "text"}], "id": 0}, {"correct": 1, "selected": 0, "_data": [{"content": "", "type": "text"}], "id": 1}], "id": 5}], "_data": [{"type": "instructions", "contents": [{"content": "Do you ever feel <span class=\"tool-tip\" id=\"tip_4_0\">pulled in a hundred different directions</span>?", "type": "text"}]}, {"type": "group", "contents": [{"content": "Activity 2", "type": "group_name"}]}, {"content": {"correct_feedback": "Correct!", "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}], "allowed_attempts": 2, "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}]}, "type": "feedback"}, {"type": "learning_skills", "contents": [{"content": "Reading", "type": "skill"}, {"content": "Writing", "type": "skill"}, {"content": "Listening", "type": "skill"}, {"content": "Speaking", "type": "skill"}]}, {"content": [{"content": "\u201c<span class=\"italic\">To be pulled a hundred different directions</span>\u201d means to be overwhelmed by too many responsibilities.", "tip_id": 0, "type": "text"}], "type": "tips"}, {"type": "post_instructions", "contents": [{"content": "Instructions: <span class=\"bullet\">Listen to the audio.</span> <span class=\"bullet\">Type in the missing words. </span><span class=\"bullet\">Record yourself saying the sentences aloud. </span>\n<span class=\"bullet\">Check your pronunciation with your instructor.</span>", "type": "text"}]}], "stimuli_ids": [], "template_override": 1, "type": "TYP", "id": 4}, {"questions": [{"_data": [{"type": "question", "contents": [{"content": "", "type": "text"}]}, {"content": "secondary_3", "type": "objective"}], "responses": [{"correct": 0, "selected": 0, "_data": [{"content": "", "type": "text"}], "id": 0}, {"correct": 1, "selected": 0, "_data": [{"content": "", "type": "text"}], "id": 1}], "id": 0}, {"_data": [{"type": "question", "contents": [{"content": "Paragraph:", "type": "text"}]}, {"content": "secondary_3", "type": "objective"}], "responses": [{"correct": 0, "selected": 0, "_data": [{"content": "", "type": "text"}], "id": 0}, {"correct": 1, "selected": 0, "_data": [{"content": "", "type": "text"}], "id": 1}], "id": 1}], "_data": [{"type": "instructions", "contents": [{"content": "<span class=\"strong\">Linking words help you to connect ideas and sentences, so that people can follow your ideas. It's your turn to write a paragraph using linking words to argue a point.</span>", "type": "text"}, {"content": "<span class=\"italic\"><br/>Instructions:</span>", "type": "text"}, {"content": "<span class=\"italic\"><span class=\"bullet\">Imagine you have a friend who you feel is being pulled a hundred different directions. They are not looking after themselves.</span><br/> <span class=\"bullet\">Write a paragraph that argues why they need to take care of themselves.</span><br/> <span class=\"bullet\">Use strong adjectives and target words.</span> <br/> <span class=\"bullet\">Include a topic sentence, supporting sentences and a concluding sentence.</span> <br/> <span class=\"bullet\">Use at least 3 linking words to connect your ideas.</span> <br/> <span class=\"bullet\">When you have typed in ALL your answers, click the <span class=\"strong\">Go to Writing Task</span> button. </span></span> ", "type": "text"}, {"content": "<br/> <br/> <span class=\"strong\">My Argument</span>", "type": "text"}]}, {"type": "group", "contents": [{"content": "Activity 3", "type": "group_name"}]}, {"content": {"correct_feedback": "You are done!", "incorrect_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}], "allowed_attempts": 2, "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}]}, "type": "feedback"}, {"type": "learning_skills", "contents": [{"content": "Reading", "type": "skill"}, {"content": "Writing", "type": "skill"}, {"content": "Listening", "type": "skill"}]}, {"type": "instructions", "contents": [{"content": "<span class=\"strong\">It's time to review your paragraph.</span>", "type": "text"}, {"content": "<br/>When you are writing your argument, remember to include: <ul><li>3 linking words to connect your ideas</li> <li>Strong adjectives</li><li>Paragraph structure</li></ul>", "type": "text"}, {"content": "Proofread your paragraph for any spelling, grammar or punctuation errors.", "type": "text"}, {"content": "Read your paragraph aloud to a partner.", "type": "text"}, {"content": "Click the <span class=\"strong\">Submit</span> button to save your work.", "type": "text"}]}, {"grading_contents": {"body": {"rows": [{"cells": [{"content_type": "text", "colspan": 1, "element": "th", "content": ""}, {"content_type": "text", "colspan": 1, "element": "th", "content": [" "], "points": "20"}, {"content_type": "text", "colspan": 1, "element": "th", "content": [" "], "points": "20"}, {"content_type": "text", "colspan": 1, "element": "th", "content": [" "], "points": "20"}, {"content_type": "text", "colspan": 1, "element": "th", "content": [" "], "points": "20"}]}, {"cells": [{"content_type": "text", "colspan": 1, "element": "th", "content": ""}, {"content_type": "text", "colspan": 1, "element": "th", "content": [" "], "points": "20"}, {"content_type": "text", "colspan": 1, "element": "th", "content": [" "], "points": "20"}, {"content_type": "text", "colspan": 1, "element": "th", "content": [" "], "points": "20"}, {"content_type": "text", "colspan": 1, "element": "th", "content": [" "], "points": "20"}]}, {"cells": [{"content_type": "text", "colspan": 1, "element": "th", "content": ""}, {"content_type": "text", "colspan": 1, "element": "th", "content": [" "], "points": "20"}, {"content_type": "text", "colspan": 1, "element": "th", "content": [" "], "points": "20"}, {"content_type": "text", "colspan": 1, "element": "th", "content": [" "], "points": "20"}, {"content_type": "text", "colspan": 1, "element": "th", "content": [" "], "points": "20"}]}, {"cells": [{"content_type": "text", "colspan": 1, "element": "th", "content": ""}, {"content_type": "text", "colspan": 1, "element": "th", "content": [" "], "points": "20"}, {"content_type": "text", "colspan": 1, "element": "th", "content": [" "], "points": "20"}, {