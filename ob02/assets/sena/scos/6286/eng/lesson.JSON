contents": [{"content": "", "type": "rec"}]}, {"content": "secondary_1", "type": "objective"}], "id": 3}, {"responses": [{"correct": 0, "_data": [{"content": "", "type": "text"}], "selected": 0, "id": 0}, {"correct": 1, "_data": [{"content": "engenn8le12ob02re3aud03", "type": "text"}], "selected": 0, "id": 1}], "_data": [{"type": "question", "contents": [{"content": "Cartoons that show positive behaviors are an option for children. What is more, children can develop good behaviors from them.", "type": "text"}]}, {"content": "secondary_1", "type": "objective"}], "id": 4}, {"responses": [{"correct": 0, "_data": [{"content": "", "type": "text"}], "selected": 0, "id": 0}, {"correct": 1, "_data": [{"content": "", "type": "text"}], "selected": 0, "id": 1}], "_data": [{"type": "question", "contents": [{"content": "", "type": "rec"}]}, {"content": "secondary_1", "type": "objective"}], "id": 5}, {"responses": [{"correct": 0, "_data": [{"content": "", "type": "text"}], "selected": 0, "id": 0}, {"correct": 1, "_data": [{"content": "engenn8le12ob02re3aud04", "type": "text"}], "selected": 0, "id": 1}], "_data": [{"type": "question", "contents": [{"content": "It is quite difficult to stop violence on TV. Nevertheless, TV stations should show more positive cartoons.", "type": "text"}]}, {"content": "secondary_1", "type": "objective"}], "id": 6}, {"responses": [{"correct": 0, "_data": [{"content": "", "type": "text"}], "selected": 0, "id": 0}, {"correct": 1, "_data": [{"content": "", "type": "text"}], "selected": 0, "id": 1}], "_data": [{"type": "question", "contents": [{"content": "", "type": "rec"}]}, {"content": "secondary_1", "type": "objective"}], "id": 7}, {"responses": [{"correct": 0, "_data": [{"content": "", "type": "text"}], "selected": 0, "id": 0}, {"correct": 1, "_data": [{"content": "engenn8le12ob02re3aud05", "type": "text"}], "selected": 0, "id": 1}], "_data": [{"type": "question", "contents": [{"content": "To sum up, TV can create either violent or cooperative behaviors in children.", "type": "text"}]}, {"content": "secondary_1", "type": "objective"}], "id": 8}, {"responses": [{"correct": 0, "_data": [{"content": "", "type": "text"}], "selected": 0, "id": 0}, {"correct": 1, "_data": [{"content": "", "type": "text"}], "selected": 0, "id": 1}], "_data": [{"type": "question", "contents": [{"content": "", "type": "rec"}]}, {"content": "secondary_1", "type": "objective"}], "id": 9}], "_data": [{"type": "instructions", "contents": [{"content": " Sally is really convincing in her arguments in her blog entry.", "type": "text"}]}, {"type": "group", "contents": [{"content": "Activity 1", "type": "group_name"}]}, {"content": {"allowed_attempts": 2, "incorrect_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}], "correct_feedback": "You are done!", "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}]}, "type": "feedback"}, {"type": "learning_skills", "contents": [{"content": "Reading", "type": "skill"}, {"content": "Listening", "type": "skill"}, {"content": "Speaking", "type": "skill"}]}, {"type": "post_instructions", "contents": [{"content": "Instructions: <span class=\"bullet\">Listen to the audio. </span> <span class=\"bullet\">Record yourself saying the sentences aloud.</span><span class=\"bullet\">Compare yourself to the audio.</span>", "type": "text"}]}], "id": 3, "stimuli_ids": []}, {"template_override": 1, "type": "MT1", "questions": [{"responses": [{"correct": 0, "_data": [{"content": "", "type": "text"}], "selected": 0, "id": 0}, {"correct": 1, "_data": [{"content": "In a recent study, researchers were trying to find out if programs with positive contents have a good effect on children.", "type": "text"}], "selected": 0, "id": 1}], "_data": [{"type": "question", "contents": [{"content": "engenn8le12ob02re4aud01", "type": "audio"}]}, {"content": "secondary_2", "type": "objective"}], "id": 0}, {"responses": [{"correct": 0, "_data": [{"content": "", "type": "text"}], "selec