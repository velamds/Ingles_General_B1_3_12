0, "_data": [{"content": "more aware of fitness in his life.", "type": "text"}], "selected": 0}, {"id": 3, "correct": 0, "_data": [{"content": "start making healthier choices.", "type": "text"}], "selected": 0}, {"id": 4, "correct": 1, "_data": [{"content": "his lunch break to exercise a little.", "type": "text"}], "selected": 0}], "id": 2, "type": "text", "_data": [{"type": "question", "contents": [{"content": "He's going to use ", "type": "text"}]}, {"content": "secondary_2", "type": "objective"}]}, {"responses": [{"id": 0, "correct": 0, "_data": [{"content": "to drink water before every meal.", "type": "text"}], "selected": 0}, {"id": 1, "correct": 0, "_data": [{"content": "everyday training.", "type": "text"}], "selected": 0}, {"id": 2, "correct": 1, "_data": [{"content": "more aware of fitness in his life.", "type": "text"}], "selected": 0}, {"id": 3, "correct": 0, "_data": [{"content": "start making healthier choices.", "type": "text"}], "selected": 0}, {"id": 4, "correct": 0, "_data": [{"content": "his lunch break to exercise a little.", "type": "text"}], "selected": 0}], "id": 3, "type": "text", "_data": [{"type": "question", "contents": [{"content": "He'll become ", "type": "text"}]}, {"content": "secondary_2", "type": "objective"}]}, {"responses": [{"id": 0, "correct": 0, "_data": [{"content": "to drink water before every meal.", "type": "text"}], "selected": 0}, {"id": 1, "correct": 1, "_data": [{"content": "everyday training.", "type": "text"}], "selected": 0}, {"id": 2, "correct": 0, "_data": [{"content": "more aware of fitness in his life.", "type": "text"}], "selected": 0}, {"id": 3, "correct": 0, "_data": [{"content": "start making healthier choices.", "type": "text"}], "selected": 0}, {"id": 4, "correct": 0, "_data": [{"content": "his lunch break to exercise a little.", "type": "text"}], "selected": 0}], "id": 4, "type": "text", "_data": [{"type": "question", "contents": [{"content": "He'll focus on", "type": "text"}]}, {"content": "secondary_2", "type": "objective"}]}], "stimuli_ids": [], "id": 11, "template_override": 1}], "_data": [{"type": "lab_options", "contents": [{"content": true, "type": "has_nav"}, {"content": true, "type": "has_exercise_controls"}]}], "stimuli": [{"id": 0, "template_override": 1, "type": "welcome", "_data": [], "contents": [{}]}, {"_data": [], "type": "audio", "id": 1, "template_override": 1, "title": "", "contents": [{"value": {"images": [{"text": "", "image": "engenn8le12ob10re2img01.jpg", "time": "0", "id": 0}, {"text": "<p>While I was checking my e-mail, I saw a note from a devoted reader. In it he mentions that he is going to make a big change in his lifestyle. Do you think you could do something similar?</p>I was looking through my photos on Facebook when I became disgusted with my appearance. I was shocked at how downtrodden I looked. That wasn't me! I guess what was in my head didn't translate to how I treated myself. I knew I had to make a change.  I used this realization as an impetus to create a strict set of rules to follow to get my life back on track again. Here they are:", "image": "engenn8le12ob10re2img01.jpg", "time": "100", "id": 1}, {"text": "<ol><li>I'm going to drink a glass of water before every meal. Everyone needs to drink more water. Plus, when I drink a glass of water before I eat I'll feel a little more full and won't be as tempted to overeat.\n</li><li>I'm going to use my lunch to be active. I'm going to make my lunch break productive. I'll go for a walk, stretch or do some sit-ups. I'll burn a few calories, burn off some stress, and feel better when I get back to work. I'll also start to make fitness a part of my daily lifestyle.\n</li></ol>", "image": "engenn8le12ob10re2img05.jpg", "time": "36500", "id": 2}, {"text": "<ol start=\"3\"><li>Lastly, I'm going to focus on accomplishments when it comes to exercise, rather than tasks. Instead of telling myself to walk 5 miles on the treadmill, I'll redirect that focus to walking home from work, or hiking up the local peak.</li></ol>", "image": "engenn8le12ob10re2img02.jpg", "time": "71500", "id": 3}], "coverimg": "engenn8le12ob10re2img01.jpg", "audiosrc": "engenn8le12ob10re2aud01"}, "type": "slideshow"}]}]}], "type": "sena", "_data": [{"type": "metadata", "contents": [{"content": "Sally's Health and Wellness Column", "type": "lesson_name"}, {"content": "Making a Big Change", "type": "unit_name"}, {"content": 10, "type": "position"}, {"content": "stub", "type": "origin"}, {"content": 12, "type": "lesson"}, {"content": "B1.3", "type": "level"}]}, {"type": "achievment_test", "contents": [{"content": "false", "type": "test"}]}, {"type": "objectives", "contents": [{"content": "Describe unusual events through a wider range of B1 language in both work and social contexts.", "type": "primary"}, {"content": "Understands important and specific information and aspects of attitude and intention in conversations, texts or presentations about the communicative functions related to this level. ", "type": "secondary_1"}, {"content": "Understands important and specific information and aspects of attitude and intention in conversations, texts or presentations about the communicative functions related to this level. ", "type": "secondary_2"}, {"content": "Understands important and specific information and aspects of attitude and intention in conversations, texts or presentations about the communicative functions related to this level. ", "type": "secondary_3"}, {"content": "Understands important and specific information and aspects of attitude and intention in conversations, texts or presentations about the communicative functions related to this level. ", "type": "secondary_4"}, {"content": "Understands important and specific information and aspects of attitude and intention in conversations, texts or presentations about the communicative functions related to this level. ", "type": "secondary_5"}, {"content": "Understands important and specific information and aspects of attitude and intention in conversations, texts or presentations about the communicative functions related to this level. ", "type": "secondary_6"}, {"content": "Understands important and specific information and aspects of attitude and intention in conversations, texts or presentations about the communicative functions related to this level. ", "type": "secondary_7"}, {"content": "Understands important and specific information and aspects of attitude and intention in conversations, texts or presentations about the communicative functions related to this level. ", "type": "secondary_8"}]}, {"content": "engenn8le12ob10re1img01.jpg", "type": "background_image"}, {"type": "learning_points", "contents": [{"content": "The Future with <span class=\"italic\">Will </span>and <span class=\"italic\">Be Going To</span>", "type": "heading"}, {"content": "You can use different tenses to talk about the future.", "type": "describer"}, {"content": "When you want to talk about facts or things you believe to be true about the future, you use <span class=\"italic\">will</span>.", "type": "text"}, {"content": "For example:<br/><span class=\"italic\">When I drink a glass of water before I eat, <span class=\"strong\">I'll feel</span> a little more full and <span class=\"strong\">won't be</span> as tempted to overeat.</span>", "type": "text"}, {"content": "When you talk about intentions, you use <span class=\"italic\">be going to</span>. These are things that you have thought about and predict for the future.", "type": "text"}, {"content": "For example: <br/><span class=\"italic\">I'<span class=\"strong\">m going to do</span> everything I can to get in shape.</span>", "type": "text"}, {"content": "{\"rows\":2,\"columns\":2,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"strong\\\">Will</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\"><ul><li>I won't go on being inadequate and lethargic.</li><li>I'll be lucky if I can run around the block. </li><li>In a couple of months, I'll be able to run a few miles.</li></ul></span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"strong\\\">Be Going to</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\"><ul><li>I'm going to buy myself a bicycle.</li><li>First of all, I'm going to begin running.</li><li>My friend George is going to run with me.  </li></ul></span>\\\"}\"],\"styles\":\"\"}", "type": "table"}]}, {"type": "learning_points", "contents": [{"content": " The Past Continuous Tense and the Simple Past Tense", "type": "heading"}, {"content": "You use the <span class=\"italic\">Past Continuous</span> tense to talk about an action that was happening at a time before now.  <br/>You use the <span class=\"italic\">Simple Past</span> to talk about a finished past action.", "type": "describer"}, {"content": "You can use the <span class=\"italic\">Past Continuous to</span>:<ul><li>Describe the atmosphere at a particular time in the past.</li></ul>", "type": "text"}, {"content": "For example: <br/><span class=\"italic\">The children <span class=\"strong\">were laughing</span> and the birds <span class=\"strong\">were singing</span> in the park. A woman <span class=\"strong\">was looking</span> for her phone, which she dropped somewhere ...</span>", "type": "text"}, {"content": "<ul><li>Describe an action that was interrupted by another event or action</li></ul>", "type": "text"}, {"content": "For example:<br/><span class=\"italic\"><span class=\"strong\">I was looking through</span> my photos on Facebook <span class=\"strong\">when I became</span> disgusted with my appearance.</span>", "type": "text"}, {"content": "The form of the <span class=\"italic\">Past Continuous</span> is:", "type": "text"}, {"content": "Subject + <span class=\"italic\">was</span>/<span class=\"italic\">were</span> + verb <span class=\"italic\">-ing</span>", "type": "text"}, {"content": "You use the <span class=\"italic\">Simple Past</span> to talk about a shorter action or event that happened in the middle of, or interrupted, the longer action.", "type": "text"}, {"content": "<span class=\"italic\">While I was checking my email, <span class=\"strong\">I saw</span> a note from a devoted reader. </span>", "type": "text"}, {"content": "While I was checking my email, I saw a note from a devoted reader.", "type": "example"}, {"content": "I was looking through my photos on Facebook when I became disgusted with my appearance. ", "type": "example"}]}, {"type": "target_word", "contents": [{"content": "devoted ", "type": "name"}, {"content": "loyal; caring ", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: I saw a note from a devoted reader. ", "type": "example"}, {"content": "engenn8le12ob10aud01", "type": "audio"}]}, {"type": "target_word_describer", "contents": [{"content": "These are words you use to talk about staying healthy.", "type": "text"}]}, {"type": "target_word", "contents": [{"content": "peak ", "type": "name"}, {"content": "the pointed top of a mountain", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: I'll hike up the local peak.", "type": "example"}, {"content": "engenn8le12ob10aud02", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "downtrodden ", "type": "name"}, {"content": "oppressed; with low energy", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: I was shocked at how downtrodden I looked. ", "type": "example"}, {"content": "engenn8le12ob10aud03", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to translate", "type": "name"}, {"content": "to explain in an easy way; to interpret", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: That didn't translate to how I treated myself. ", "type": "example"}, {"content": "engenn8le12ob10aud04", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "realization ", "type": "name"}, {"content": "the act of understanding something", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: I used this realization to create my regimen.", "type": "example"}, {"content": "engenn8le12ob10aud05", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "impetus ", "type": "name"}, {"content": "impulse; a force that moves someone into action", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: I had an impetus to create a strict set of rules to follow. ", "type": "example"}, {"content": "engenn8le12ob10aud06", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to overeat", "type": "name"}, {"content": "to eat in excess", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: If I drink water, I won't be tempted to overeat.", "type": "example"}, {"content": "engenn8le12ob10aud07", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to burn", "type": "name"}, {"content": "to consume, especially calories, and give off energy", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: I'll burn a few calories.", "type": "example"}, {"content": "engenn8le12ob10aud08", "type": "audio"}]}, {"type": "takeaway_extension", "contents": [{"content": "Think about three ways to make your day healthier.", "type": "text"}, {"content": "Write down your ideas and add some details to each.", "type": "text"}, {"content": "Share them with your partner. Do you have similar ideas?", "type": "text"}]}, {"type": "takeaway_assessment", "contents": [{"content": "I write about ways to improve my life.", "type": "text"}, {"content": "I add details to each idea.", "type": "text"}, {"content": "I discuss my ideas with a partner.", "type": "text"}]}]}