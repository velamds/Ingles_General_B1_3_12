content": "have"}], "selected": 0, "id": 1}, {"correct": 1, "text": "", "id": 2, "selected": 0, "_data": [{"type": "text", "content": "to have"}]}], "id": 2, "_data": [{"type": "question", "contents": [{"type": "audio", "content": "engenn8le12ob06re4aud03"}]}, {"type": "objective", "content": "secondary_2"}]}, {"responses": [{"correct": 1, "_data": [{"type": "text", "content": "sleeping"}], "selected": 0, "id": 0}, {"correct": 0, "_data": [{"type": "text", "content": "sleep"}], "selected": 0, "id": 1}, {"correct": 0, "text": "", "id": 2, "selected": 0, "_data": [{"type": "text", "content": "to sleep"}]}], "id": 3, "_data": [{"type": "question", "contents": [{"type": "audio", "content": "engenn8le12ob06re4aud04"}]}, {"type": "objective", "content": "secondary_2"}]}, {"responses": [{"correct": 0, "_data": [{"type": "text", "content": "sleeping"}], "selected": 0, "id": 0}, {"correct": 1, "_data": [{"type": "text", "content": "to sleep"}], "selected": 0, "id": 1}, {"correct": 0, "text": "", "id": 2, "selected": 0, "_data": [{"type": "text", "content": "sleep"}]}], "id": 4, "_data": [{"type": "question", "contents": [{"type": "audio", "content": "engenn8le12ob06re4aud05"}]}, {"type": "objective", "content": "secondary_2"}]}], "template_override": 1, "id": 11, "_data": [{"type": "instructions", "contents": [{"type": "text", "content": "Sally wanted to hear her own ideas before including them in her blog entry."}]}, {"type": "group", "contents": [{"type": "group_name", "content": "Activity 2"}]}, {"type": "feedback", "content": {"allowed_attempts": 2, "correct_feedback": "Correct!", "attempt_feedback": [{"type": "text", "content": ""}, {"type": "text", "content": ""}], "incorrect_feedback": [{"type": "text", "content": "Whoops! Something important is missing."}, {"type": "text", "content": "Maybe next time..."}]}}, {"type": "learning_skills", "contents": [{"type": "skill", "content": "Listening"}, {"type": "skill", "content": "Reading"}]}, {"type": "post_instructions", "contents": [{"type": "text", "content": "Instructions: Listen to the audio. Select the verb the person uses in her speech."}, {"type": "text", "content": "You have 2 attempts to submit your answers."}]}]}], "type": "scholar", "_data": [{"type": "lab_options", "contents": [{"type": "has_nav", "content": true}, {"type": "has_exercise_controls", "content": true}]}], "id": 0, "stimuli": [{"type": "welcome", "template_override": 1, "_data": [], "id": 0, "contents": [{}]}, {"contents": [{"type": "slideshow", "value": {"coverimg": "engenn8le12ob06re2img01.jpg", "audiosrc": "engenn8le12ob06re2aud01", "images": [{"time": "0", "image": "engenn8le12ob06re2img01.jpg", "text": "", "id": 0}, {"time": "100", "image": "engenn8le12ob06re2img01.jpg", "text": "All of us complain about not being able to sleep sometimes. However, if you're the kind of person who finds himself staring at the ceiling until late into the night, experts suggest looking at your diet.", "id": 1}, {"time": "12000", "image": "engenn8le12ob06re2img02.jpg", "text": "Research has shown that what people eat during the day, and when they eat, can be connected to how well they sleep at night. For instance, if you eat a big meal an hour or two before going to bed, you probably won't sleep well, or it may take you longer to fall asleep.<br/>\nIf your meal is spicier or more fatty than usual, the chances of not sleeping are even greater. Sleep specialists say you are supposed to eat supper early. Then if you feel hungry later on in the evening, you are supposed to have something light, like a cereal or crackers.", "id": 2}, {"time": "45000", "image": "engenn8le12ob06re2img03.jpg", "text": "Another reason that people don't sleep is because they don't eat enough. If you're on a diet, you may have trouble going to sleep. When you go to sleep hungry, your brain tells you to stay awake so that you can look for food. It is a natural survival instinct. Experts suggest that if you have trouble sleeping, it's best to try having a light snack before going to bed.<br/>\nIn addition, you are supposed to keep a regular eating schedule during the day. If you grab food without eating regular meals, expect to have trouble sleeping.", "id": 3}]}}], "template_override": 1, "title": "", "type": "audio", "id": 1, "_data": []}]}], "_data": [{"type": "metadata", "contents": [{"type": "lesson_name", "content": "Sally's Health and Wellness Column"}, {"type": "unit_name", "content": "The Research on Sleep"}, {"type": "position", "content": 6}, {"type": "origin", "content": "stub"}, {"type": "lesson", "content": 12}, {"type": "level", "content": "B1.3"}]}, {"type": "achievment_test", "contents": [{"type": "test", "content": "false"}]}, {"type": "objectives", "contents": [{"type": "primary", "content": "Describe unusual events through a wider range of B1 language in both work and social contexts."}, {"type": "secondary_1", "content": "Understands important and specific information and aspects of attitude and intention in conversations, texts or presentations about the communicative functions related to this level. "}, {"type": "secondary_2", "content": "Understands important and specific information and aspects of attitude and intention in conversations, texts or presentations about the communicative functions related to this level. "}, {"type": "secondary_3", "content": "Understands important and specific information and aspects of attitude and intention in conversations, texts or presentations about the communicative functions related to this level. "}, {"type": "secondary_4", "content": "Understands important and specific information and aspects of attitude and intention in conversations, texts or presentations about the communicative functions related to this level. "}, {"type": "secondary_5", "content": "Understands important and specific information and aspects of attitude and intention in conversations, texts or presentations about the communicative functions related to this level. "}, {"type": "secondary_6", "content": "Understands important and specific information and aspects of attitude and intention in conversations, texts or presentations about the communicative functions related to this level. "}, {"type": "secondary_7", "content": "Understands important and specific information and aspects of attitude and intention in conversations, texts or presentations about the communicative functions related to this level. "}, {"type": "secondary_8", "content": "Understands important and specific information and aspects of attitude and intention in conversations, texts or presentations about the communicative functions related to this level. "}]}, {"type": "background_image", "content": "engenn8le12ob06re1img01.jpg"}, {"type": "learning_points", "contents": [{"type": "heading", "content": "<span class=\"italic\">Be Supposed To </span>"}, {"type": "describer", "content": "You use the structure <span class=\"strong\">be supposed to</span> when you want to talk about expectations, obligations or arrangements. "}, {"type": "text", "content": "You can use <span class=\"strong\">be supposed to</span> to talk about situations in the past, present or future."}, {"type": "text", "content": "The structure is:  <br/> <br/>Subject + <span class=\"italic\">To be</span> + <span class=\"italic\">supposed to</span> + verb"}, {"type": "text", "content": "<span class=\"italic\">Sleep specialists <span class=\"strong\">say you are supposed to eat</span> supper early.</span>"}, {"type": "text", "content": "**Pronunciation tip**: <br/>When you say be supposed to, you link the /d/ and /t/ sounds together. <br/> <br/> Like this: Be suppose_to"}, {"type": "example", "content": "Then if you feel hungry later on in the evening, you are supposed to have something light, like a cereal or crackers."}, {"type": "example", "content": "In addition, you are supposed to keep a regular eating schedule during the day. "}, {"type": "example", "content": "Sleep specialists say you are supposed to eat supper early. <br/> <br/>"}]}, {"type": "learning_points", "contents": [{"type": "heading", "content": "Gerunds and Infinitives"}, {"type": "describer", "content": "<p>A <span class=\"strong\">gerund </span>is a verb ending with <span class=\"italic\">-ing</span>.<span class=\"italic\"> Examples: writing, laughing, cleaning sleeping. </span><br/>An <span class=\"strong\">infinitive</span> is when a verb is preceded by the word<span class=\"italic\">  to</span>. Examples: <span class=\"italic\">to write - to laugh - to clean - to sleep. </span>"}, {"type": "text", "content": "Verbs commonly followed by a gerund:"}, {"type": "text", "content": "Verbs that express <span class=\"strong\">likes/dislikes</span>:<ul><li>like</li><li>love</li><li>enjoy</li><li>dislike</li><li>hate</li></ul>"}, {"type": "text", "content": "Example: <br/><span class=\"italic\">Tom <span class=\"strong\">disliked eating</span> plain yogurt. </span>"}, {"type": "text", "content": "<span class=\"italic\">like</span>/<span class=\"italic\">love</span>/<span class=\"italic\">hate</span> can also be followed by an infinitive."}, {"type": "text", "content": "Some other verbs that are followed by a gerund:"}, {"type": "text", "content": "<ul><li>anticipate</li><li>suggest</li><li>delay</li><li>complete</li><li>involve</li><li>keep</li><li>risk</li></ul>"}, {"type": "text", "content": "You use a gerund after some expressions: <span class=\"italic\"><ul><li>Have trouble ...</li><li>I don't mind ...</li><li>It's no use ...</li></ul></span>"}, {"type": "text", "content": "You also use gerunds after prepositions, for example:  <br/><span class=\"italic\"><span class=\"strong\">Before</span> going to sleep ...</span>"}, {"type": "text", "content": "These are some verbs that are followed by an infinitive:"}, {"type": "text", "content": "<ul><li>hope</li><li>aim</li><li>expect</li><li>decide</li><li>help</li><li>happen</li></ul>"}, {"type": "text", "content": "Example: <br/><span class=\"italic\">You should <span class=\"strong\">aim to eat</span> yogurt every day. </span>"}, {"type": "text", "content": "You use Infinitives after adjectives. "}, {"type": "text", "content": "Example: <br/><span class=\"italic\">It may take you <span class=\"strong\">longer to fall</span> asleep.</span>"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "specialist "}, {"type": "definition", "content": "an expert in a specific area"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: Sleep specialists say you are supposed to eat supper early."}, {"type": "audio", "content": "engenn8le12ob06aud01"}]}, {"type": "target_word_describer", "contents": [{"type": "text", "content": "These are words you use to talk about staying healthy."}]}, {"type": "target_word", "contents": [{"type": "name", "content": "ceiling "}, {"type": "definition", "content": "the surface above your head in a room"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: You stare at the ceiling until late at night."}, {"type": "audio", "content": "engenn8le12ob06aud02"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "light "}, {"type": "definition", "content": "easy to digest"}, {"type": "part_speech", "content": "(adjective)"}, {"type": "example", "content": "Example: You are supposed to have something light."}, {"type": "audio", "content": "engenn8le12ob06aud03"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "cracker "}, {"type": "definition", "content": "thin, salty food, made of flour and other ingredients"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: Cereal or crackers are a light snack."}, {"type": "audio", "content": "engenn8le12ob06aud04"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "survival instinct"}, {"type": "definition", "content": "the natural impulse to take care of your own life"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: Staying awake when you're hungry is a natural survival instinct."}, {"type": "audio", "content": "engenn8le12ob06aud05"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "snack "}, {"type": "definition", "content": "a small portion of food that you eat between meals"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: If you feel hungry at night, you are supposed to eat a light snack."}, {"type": "audio", "content": "engenn8le12ob06aud06"}]}, {"type": "takeaway_extension", "contents": [{"type": "text", "content": "To see the affect of what you eat on how you sleep, keep a food journal for a week."}, {"type": "text", "content": "Every night, write down in English what you eat for dinner/supper/snack."}, {"type": "text", "content": "In the morning, write down notes about how you slept."}, {"type": "text", "content": "At the end of the week, share your results with a partner. "}]}, {"type": "takeaway_assessment", "contents": [{"type": "text", "content": "I keep a food journal for a week."}, {"type": "text", "content": "I keep track of what I eat and how I sleep."}, {"type": "text", "content": "I share the results with my partner."}]}]}